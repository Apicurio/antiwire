<?xml version="1.0" encoding="UTF-8"?>
<!--
  Isolated okio behavior oracle (TASK-4 AC#3): this module compiles the shared adapted
  behavior tests in ../okio-behavior-tests against UPSTREAM okio-jvm 3.18.2 in test scope
  and runs them, proving the adapted cases are faithful (they pass against the artifact
  they were adapted from). The okio-jvm dependency is test-scoped only, which the enforcer
  dependency policy allows and the duplicate-class check scans: this module never sits on
  a port-under-test classpath. It ships no classes of its own and is never deployed.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.paoloantinori</groupId>
    <artifactId>antiwire-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>okio-behavior-oracle</artifactId>

  <name>antiwire okio-behavior-oracle (isolated oracle harness)</name>
  <description>
    Compiles the shared adapted okio behavior tests against upstream okio-jvm 3.18.2 in an
    isolated test scope. Publishes nothing; certifies only the fidelity of the adapted cases.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.squareup.okio</groupId>
      <artifactId>okio-jvm</artifactId>
      <version>3.18.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Test tooling only (DEC-4): this module has no production sources. Its Kotlin test
        sources are the SHARED adapted behavior tests, the same files wire-runtime-java
        compiles against the port, so the two executions differ only in the okio under test.
      -->
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>kotlin-test-compile</id>
            <goals>
              <goal>test-compile</goal>
            </goals>
            <configuration>
              <sourceDirs>
                <sourceDir>${project.basedir}/../okio-behavior-tests/src/kotlin</sourceDir>
              </sourceDirs>
              <jvmTarget>11</jvmTarget>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
