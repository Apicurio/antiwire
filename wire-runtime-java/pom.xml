<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runtime module. Holds the M0 execution state: the vendored okio buffer subset (TASK-4
  core), the translated encoding core (TASK-5 core), and their tests. OPEN-2 fixed boundary:
  this module depends on nothing in production scope.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.apicurio</groupId>
    <artifactId>antiwire-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wire-runtime-java</artifactId>

  <name>antiwire wire-runtime-java</name>
  <description>
    Pure-Java port of Wire's runtime at the pinned upstream tag (DEC-1). M0 state: vendored
    okio buffer subset plus the encoding core; later runtime work lands with TASK-6 through
    TASK-8 and its tests with TASK-9.
  </description>

  <dependencies>
    <!-- Parity oracle fixture: upstream wire-runtime-jvm relocated, test scope only.
         The exclusion is required in-reactor: the fixture's original pom still declares
         wire-runtime-jvm compile (the dependency-reduced pom applies only once installed),
         which would leak the unrelocated upstream jar onto this test classpath next to the
         port's own classes, violating DEC-2's duplicate-class rule. kotlin-stdlib still
         arrives from the parent's test-scope declaration. -->
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>wire-upstream-shaded</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>com.squareup.wire</groupId>
          <artifactId>wire-runtime-jvm</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- The vendored okio tests are JUnit 4; the vintage engine runs them next to the
         parent's JUnit 5 platform. -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <!-- Upstream runtime tests stay Kotlin (DEC-5) with assertk; the kotlin.test.Test
         annotation maps to the Jupiter one already on the classpath (recorded per site in
         src/test/kotlin/com/squareup/wire/UPSTREAM-TEST-ADAPTATIONS.md). assertk resolves
         through its JVM artifact on Maven (the bare artifact is the KMP marker). -->
    <dependency>
      <groupId>com.willowtreeapps.assertk</groupId>
      <artifactId>assertk-jvm</artifactId>
      <version>0.28.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
