<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runtime module shell (TASK-2). Empty: reserves com.squareup.wire only, no functionality,
  no parity claim. OPEN-2 fixed boundary: this module depends on nothing in production scope.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.paoloantinori</groupId>
    <artifactId>antiwire-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wire-runtime-java</artifactId>

  <name>antiwire wire-runtime-java (runtime port)</name>
  <description>
    Runtime module. Carries the translated okio subset under the retained okio.* names
    (OPEN-1 route) that the Wire runtime and schema loader build on.
  </description>

  <build>
    <plugins>
      <!--
        Test tooling only (DEC-4): the shared adapted okio behavior tests are compiled against
        this module's okio classes AND, in the isolated okio-behavior-oracle module, against
        upstream okio-jvm 3.18.2. Same files, two implementations, one fidelity statement.
      -->
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>kotlin-test-compile</id>
            <goals>
              <goal>test-compile</goal>
            </goals>
            <configuration>
              <sourceDirs>
                <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
                <sourceDir>${project.basedir}/../okio-behavior-tests/src/kotlin</sourceDir>
              </sourceDirs>
              <jvmTarget>11</jvmTarget>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
