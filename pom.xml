<?xml version="1.0" encoding="UTF-8"?>
<!--
  antiwire parent pom.

  Coordinates: groupId io.apicurio per the DEC-8 resolution (maintainer directive
  2026-10-02; docs/decisions.md), which replaced the earlier io.github.paoloantinori
  placeholder. Publishing stays closed until TASK-21's release gates pass and the
  maintainer approves the final candidate: maven.deploy.skip is set below as a guard.

  Module boundaries are the fixed ones of OPEN-2: runtime standalone, schema depending on
  runtime, generator optional; the test-only modules (wire-upstream-shaded parity fixture,
  wire-tests-java, wire-protoc-compat-java) are never published.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.apicurio</groupId>
  <artifactId>antiwire-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>antiwire parent</name>
  <description>
    Pure-Java port of Square Wire 7.1.0: runtime, schema, and optional generator modules plus
    test-only fixture, tests, and protoc-oracle modules. Production compilation uses --release 11 on a JDK 17+ toolchain (DEC-3).
  </description>

  <modules>
    <!-- Declared first: consumers use this never-published test fixture on their test
         classpaths (parity oracle), so it must package before them. -->
    <module>wire-upstream-shaded</module>
    <module>wire-runtime-java</module>
    <module>wire-schema-java</module>
    <module>wire-tests-java</module>
    <!-- TASK-15: protoc interoperability oracle module; never published (test-only). -->
    <module>wire-protoc-compat-java</module>
    <module>wire-java-generator</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- DEC-3: production bytecode targets Java 11 while the build toolchain stays JDK 17+. -->
    <maven.compiler.release>11</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <kotlin.version>2.1.21</kotlin.version>
    <!--
      Divergence from upstream (maintainer decision, 2026-10-02): upstream Wire 7.1.0 builds
      against com.palantir.javapoet:javapoet:0.19.0 (gradle/libs.versions.toml), but every
      palantir javapoet release ships major-61 (Java 17) class files, which DEC-3 forbids for
      production dependencies. Square JavaPoet 1.13.0 is the pure-Java upstream of that fork,
      runs on Java 8+, and reproduces the pinned upstream golden byte-for-byte: the port's
      WireCompiler output for wire-golden-files all_types_proto3.proto is identical to the
      checked-in golden with this artifact (established 2026-10-02; since the no-okio phase 2
      of 2026-10-03 the port's output diverges from that golden by exactly the documented
      Bytes mapping, checked mechanically by AllTypesGoldenBytesMappingTest). The only API
      difference in the ported call sites is field-for-method access (JavaFile.packageName/
      typeSpec, ParameterizedTypeName.rawType).
    -->
    <javapoet.version>1.13.0</javapoet.version>
    <!-- Guard for DEC-8: publishing is a separate gate (TASK-21 AC#1); nothing may be deployed before the maintainer approves the release. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-stdlib</artifactId>
        <version>${kotlin.version}</version>
      </dependency>
      <dependency>
        <groupId>io.apicurio</groupId>
        <artifactId>wire-runtime-java</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.apicurio</groupId>
        <artifactId>wire-schema-java</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Pure-Java JavaPoet; the only third-party production dependency of the optional
           generator module (explicitly permitted by the module boundary in OPEN-2). See the
           javapoet.version property comment for why this is the Square artifact, not upstream
           Wire's palantir fork. -->
      <dependency>
        <groupId>com.squareup</groupId>
        <artifactId>javapoet</artifactId>
        <version>${javapoet.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    Test tooling only (DEC-4): JUnit and the Kotlin standard library are declared test-scoped
    so Kotlin test compilation is wired from day one. Test scope is not transitive, so these
    never leak into published dependency metadata, and maven-enforcer below bans Kotlin from
    production scope in every module.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <!--
          TASK-21 release plumbing: versions and shared configuration for the sources and
          javadoc jars. Only the three shipped modules declare the executions (their poms);
          the never-published modules (fixture, tests, protoc oracle) attach nothing.

          Doclint scoping is deliberate. The javadoc tool's default (-Xdoclint:all) fails the
          build on pre-existing upstream doc conventions preserved verbatim by the port:
          h3 headings without a preceding h2 (okio Timeout/Sink/Source/Buffer and schema
          PruningRules/WireRun/EmittingRules) and legacy table attributes (okio Utf8). The
          html group is disabled to tolerate those; reference and syntax checks stay on, so
          a broken {@link} or malformed javadoc still fails the build. The missing group is
          disabled to suppress the hundreds of upstream @param/@return omissions, which are
          warnings only and never failed the build. Full-baseline record (11 errors at the
          time of this change): docs/license-inventory.md appendix D.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <configuration>
            <doclint>all,-missing,-html</doclint>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>enforce-toolchain-and-production-dependency-policy</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[17,)</version>
                  <message>Building antiwire requires JDK 17 or later. Production bytecode still targets Java 11 via maven.compiler.release (DEC-3); the Java 11 consumer check runs on a separately provisioned JVM.</message>
                </requireJavaVersion>
                <!--
                  DEC-4: no Kotlin in production scope, including transitives. The scope field
                  in each pattern keeps test-scoped Kotlin (allowed for test tooling) out of
                  the ban. okio artifacts are banned in production scope because modern okio
                  is Kotlin-backed; if a vendored okio subset is chosen under OPEN-1 it lands
                  as port source, never as a production dependency.
                -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <message>Kotlin or a Kotlin-backed artifact appeared in production scope, which DEC-4 forbids. Move it to test scope (test tooling) or vendor it as port source; Kotlin-backed production dependencies are not allowed.</message>
                  <excludes>
                    <exclude>org.jetbrains.kotlin:*:*:*:compile:*</exclude>
                    <exclude>org.jetbrains.kotlin:*:*:*:runtime:*</exclude>
                    <exclude>org.jetbrains.kotlin:*:*:*:provided:*</exclude>
                    <exclude>org.jetbrains.kotlinx:*:*:*:compile:*</exclude>
                    <exclude>org.jetbrains.kotlinx:*:*:*:runtime:*</exclude>
                    <exclude>org.jetbrains.kotlinx:*:*:*:provided:*</exclude>
                    <exclude>com.squareup.okio:*:*:*:compile:*</exclude>
                    <exclude>com.squareup.okio:*:*:*:runtime:*</exclude>
                    <exclude>com.squareup.okio:*:*:*:provided:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Kotlin test compilation ONLY (DEC-4): the single execution binds test-compile with no
        production execution anywhere. src/test/kotlin is the only Kotlin source root.
      -->
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>kotlin-test-compile</id>
            <goals>
              <goal>test-compile</goal>
            </goals>
            <configuration>
              <sourceDirs>
                <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
              </sourceDirs>
              <jvmTarget>11</jvmTarget>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Export the resolved classpaths that scripts/check-classpath.sh and
        scripts/check-java11-bytecode.sh verify (duplicate-class prevention and Java 11
        bytecode gate). Runtime scope here means what production consumers resolve;
        test scope is the full port-under-test classpath.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>export-test-classpath</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <includeScope>test</includeScope>
              <outputFile>${project.build.directory}/classpath-test.txt</outputFile>
            </configuration>
          </execution>
          <execution>
            <id>export-runtime-classpath</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputFile>${project.build.directory}/classpath-runtime.txt</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
