<?xml version="1.0" encoding="UTF-8"?>
<!--
  TASK-15 protoc interoperability oracle module. Never published (test-only):
  it hosts the protoc-generated reference models and the ported upstream
  wire-protoc-compatibility-tests cases. Maven central deploy is blocked by
  maven.deploy.skip from the parent.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.apicurio</groupId>
    <artifactId>antiwire-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wire-protoc-compat-java</artifactId>

  <name>antiwire wire-protoc-compat-java (protoc oracle)</name>
  <description>protoc 4.36.1 interoperability oracle: reference models from the pinned
    protoc and the pinned upstream wire compiler 7.1.0, plus the ported upstream
    compatibility test cases. Never published.</description>

  <dependencies>
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>wire-runtime-java</artifactId>
    </dependency>
    <!-- Reference implementation runtime: the protoc-generated models and the interop
         assertions run against the real protobuf-java, isolated from the port. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>4.36.1</version>
    </dependency>
    <!-- JsonFormat: the upstream compatibility cases assert protoc's own JSON printing and
         parsing behavior. Test scope only; the port's JSON adapters are a DEC-6 exclusion. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
      <version>4.36.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- SchemaEncoderInteropTest loads the pinned module protos through the port's own
         schema machinery. Test scope only. -->
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>wire-schema-java</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- EmptyRoundTripTest generates its wire-side AllEmpty model with the port's own
         generator at test time (TASK-16.1), compiles it against the port runtime at
         Java 11 source level with no Kotlin on the classpath, and byte-compares against
         the protoc oracle fixture. Test scope only: the oracle module never ships, and no
         production consumer pulls the generator (OPEN-2 fixed boundary). -->
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>wire-java-generator</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Shared test fixtures (com.squareup.wire.testing.TestFiles, including the pinned
         upstream-clone lookup the interop test uses). Test scope only. -->
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>wire-schema-java</artifactId>
      <version>${project.version}</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
